{
  "name": "rtpm-design-system",
  "version": "0.1.0",
  "private": true,
  "description": "RTPM brand system — design tokens and React components",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tokens/tokens.css": "./tokens/tokens.css"
  },
  "files": [
    "dist",
    "tokens"
  ],
  "scripts": {
    "build": "tsup index.ts --format esm,cjs --dts --out-dir dist"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  }
}
