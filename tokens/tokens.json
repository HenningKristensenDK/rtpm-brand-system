{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "RTPM Brand System v4 design tokens. Extracted from the five RTPM v4 knowledge files. Scope: web-facing surfaces (marketing site, rtpm.dk, React demo / next-gen frontend). Not the Power Apps delivery product. Layer 1 = primitives (raw values, never consumed directly). Layer 2 = semantic aliases (what components consume).",
  "$version": "4.0.0",
  "$source": [
    "RTPM 0. Product Design System",
    "RTPM 1. Core Tokens",
    "RTPM 2. Marketing Graphics",
    "RTPM 3. Completion Surfaces",
    "RTPM 4. Website Architecture"
  ],

  "primitive": {
    "color": {
      "$type": "color",
      "inkNavy":         { "$value": "#070474", "$description": "Dark surfaces: sidebar, hero band, footer, media overlay. Logo colour on light." },
      "indigo":          { "$value": "#0D08D2", "$description": "Signal only: active states, key nodes, hairlines, links, first chart series. Never a large fill." },
      "indigoHover":     { "$value": "#0A06A8" },
      "navyLabel":       { "$value": "#CFCEFF", "$description": "Eyebrow and label text on Ink Navy." },
      "navyMute":        { "$value": "#CFCEFF", "$deprecated": "Was #6F6DC9. Consolidated into navyLabel — use primitive.color.navyLabel instead." },
      "gold":            { "$value": "#FFCC00", "$description": "Primary action only, one per screen. One highlight per visual, on dark only. Never a logo colour." },
      "goldHover":       { "$value": "#F2C200" },
      "ink":             { "$value": "#15162B", "$description": "All body and heading text on light. Never pure black." },
      "slate":           { "$value": "#595B78", "$description": "Secondary text. 6.58:1 on card — AA." },
      "mute":            { "$value": "#8A8CA6", "$description": "3.3:1 on white. Large text and non-text only, never body copy." },
      "muteSoft":        { "$value": "#B9BACB", "$description": "Disabled label, dashed construction guide." },
      "white":           { "$value": "#FFFFFF" },
      "paper":           { "$value": "#F7F7FB", "$description": "Page background." },
      "mist":            { "$value": "#FAFAFD", "$description": "Inset / nested surface. Ratified into RTPM 1 section 01 as Inset." },
      "line":            { "$value": "#E6E6F0", "$description": "Default border." },
      "lineSoft":        { "$value": "#F0F0F5", "$description": "Inner rule inside a card. Sole meaning as of the Option A resolution." },
      "disabledBg":      { "$value": "#F2F2F7" },
      "indigoTint":      { "$value": "#E7E6FA" },
      "indigoTintLine":  { "$value": "#D6D4F5" },
      "black":           { "$value": "#000000", "$description": "Monochrome logo reproduction only." },

      "red":             { "$value": "#E63946", "$description": "Critical." },
      "orange":          { "$value": "#FF8B00", "$description": "High." },
      "amber":           { "$value": "#E0A800", "$description": "Medium. Deliberately not #FFCC00 — two meanings cannot share a hex." },
      "green":           { "$value": "#28A745", "$description": "Low / Done." },
      "grey":            { "$value": "#E6E6F0", "$description": "Not started / chart remainder. Moved off #F0F0F5 (Option A) so the inner card rule holds that hex alone." },
      "greyLine":        { "$value": "#DCDCE8", "$description": "Border on the chart remainder fill, so it stays visible against #E6E6F0." },

      "redTint":         { "$value": "#FDECEE" },
      "redInk":          { "$value": "#B02A34" },
      "orangeTint":      { "$value": "#FFF3E5" },
      "orangeInk":       { "$value": "#B36200" },
      "amberTint":       { "$value": "#FDF4DD" },
      "amberInk":        { "$value": "#8A6600" },
      "greenTint":       { "$value": "#E8F6EB" },
      "greenInk":        { "$value": "#1B7A31" },

      "series1":         { "$value": "#0D08D2" },
      "series2":         { "$value": "#00C794" },
      "series3":         { "$value": "#FF8B00" },
      "series4":         { "$value": "#00ACFF" },
      "series5":         { "$value": "#AA00D3" },
      "seriesAlt":       { "$value": null, "$deprecated": "Was #5652E0. Removed from all source files — charts now use series2, the RTPM 2 connector uses indigo." }
    },

    "retired": {
      "$description": "Do not reintroduce. Sampling artifacts and superseded choices.",
      "colors": ["#2E2CA1", "#0A0868"],
      "fonts":  ["Montserrat"]
    },

    "font": {
      "$type": "fontFamily",
      "display": { "$value": "Barlow Semi Condensed", "$description": "Marketing, decks, carousels, thumbnails. Never app UI. Semi Condensed, not Condensed." },
      "ui":      { "$value": "Inter" },
      "mono":    { "$value": "ui-monospace, SFMono-Regular, Menlo, monospace" }
    },

    "weight": {
      "$type": "fontWeight",
      "regular":  { "$value": 400 },
      "medium":   { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold":     { "$value": 700 }
    },

    "space": {
      "$type": "dimension",
      "1": { "$value": "4px" },
      "2": { "$value": "8px" },
      "3": { "$value": "12px" },
      "4": { "$value": "16px" },
      "6": { "$value": "24px" },
      "8": { "$value": "32px" }
    },

    "radius": {
      "$type": "dimension",
      "card":  { "$value": "14px" },
      "input": { "$value": "9px" },
      "pill":  { "$value": "999px" },
      "sharp": { "$value": "0", "$description": "The mark and its pictograms. Rounding closes the negative-space channels." }
    },

    "shadow": {
      "$type": "shadow",
      "hairline": { "$value": "0 1px 2px rgba(21, 22, 43, 0.10)" },
      "raised":   { "$value": "0 2px 8px rgba(21, 22, 43, 0.08)" },
      "overlay":  { "$value": "0 8px 24px rgba(21, 22, 43, 0.12)" }
    }
  },

  "semantic": {
    "surface": {
      "$type": "color",
      "page":     { "$value": "{primitive.color.paper}" },
      "card":     { "$value": "{primitive.color.white}" },
      "inset":    { "$value": "{primitive.color.mist}" },
      "dark":     { "$value": "{primitive.color.inkNavy}", "$description": "The only approved dark surface." },
      "selected": { "$value": "{primitive.color.indigoTint}" },
      "disabled": { "$value": "{primitive.color.disabledBg}" }
    },

    "text": {
      "$type": "color",
      "primary":     { "$value": "{primitive.color.ink}",       "$contrast": "16.63:1 on page — AAA" },
      "secondary":   { "$value": "{primitive.color.slate}",     "$contrast": "6.58:1 on card — AA" },
      "muted":       { "$value": "{primitive.color.mute}",      "$contrast": "3.3:1 on white — large text and non-text only" },
      "disabled":    { "$value": "{primitive.color.muteSoft}" },
      "onDark":      { "$value": "{primitive.color.white}",     "$contrast": "16.42:1 on Ink Navy — AAA" },
      "onDarkMuted": { "$value": "{primitive.color.navyLabel}" },
      "link":        { "$value": "{primitive.color.indigo}" },
      "linkHover":   { "$value": "{primitive.color.inkNavy}" }
    },

    "border": {
      "$type": "color",
      "default":  { "$value": "{primitive.color.line}" },
      "subtle":   { "$value": "{primitive.color.lineSoft}" },
      "selected": { "$value": "{primitive.color.indigo}" },
      "tint":     { "$value": "{primitive.color.indigoTintLine}" },
      "onDark":   { "$value": "rgba(255, 255, 255, 0.22)" }
    },

    "signal": {
      "$type": "color",
      "default":   { "$value": "{primitive.color.indigo}" },
      "focusRing": { "$value": "{primitive.color.indigoTint}" }
    },

    "action": {
      "$type": "color",
      "$description": "One gold action per screen — the one that sends something out of the system and creates a record. Everything else is indigo or ghost.",
      "primaryBg":       { "$value": "{primitive.color.gold}" },
      "primaryBgHover":  { "$value": "{primitive.color.goldHover}" },
      "primaryText":     { "$value": "{primitive.color.ink}", "$description": "Ink, never white." },
      "secondaryBg":     { "$value": "{primitive.color.indigo}" },
      "secondaryBgHover":{ "$value": "{primitive.color.indigoHover}" },
      "secondaryText":   { "$value": "{primitive.color.white}" },
      "tertiaryBg":      { "$value": "{primitive.color.white}" },
      "tertiaryBgHover": { "$value": "{primitive.color.paper}" },
      "tertiaryText":    { "$value": "{primitive.color.ink}" },
      "ghostText":       { "$value": "{primitive.color.indigo}" },
      "ghostBgHover":    { "$value": "{primitive.color.indigoTint}" },
      "disabledBg":      { "$value": "{primitive.color.disabledBg}" },
      "disabledText":    { "$value": "{primitive.color.muteSoft}" },
      "height":          { "$type": "dimension", "$value": "40px" },
      "radius":          { "$type": "dimension", "$value": "{primitive.radius.input}" }
    },

    "status": {
      "$type": "color",
      "$description": "Fixed meaning. Colour never carries state alone — always paired with a dot plus label in tables.",
      "critical":     { "$value": "{primitive.color.red}" },
      "criticalBg":   { "$value": "{primitive.color.redTint}" },
      "criticalText": { "$value": "{primitive.color.redInk}" },
      "high":         { "$value": "{primitive.color.orange}" },
      "highBg":       { "$value": "{primitive.color.orangeTint}" },
      "highText":     { "$value": "{primitive.color.orangeInk}" },
      "medium":       { "$value": "{primitive.color.amber}" },
      "mediumBg":     { "$value": "{primitive.color.amberTint}" },
      "mediumText":   { "$value": "{primitive.color.amberInk}" },
      "low":          { "$value": "{primitive.color.green}" },
      "lowBg":        { "$value": "{primitive.color.greenTint}" },
      "lowText":      { "$value": "{primitive.color.greenInk}" },
      "none":         { "$value": "{primitive.color.grey}" }
    },

    "step": {
      "$type": "color",
      "$description": "Four fixed stages on every record, every module. Only the current node turns red when late — red here reads 'this stage is late', not 'critical severity'.",
      "done":        { "$value": "{primitive.color.green}" },
      "current":     { "$value": "{primitive.color.indigo}" },
      "currentRing": { "$value": "{primitive.color.indigoTint}" },
      "pending":     { "$value": "{primitive.color.line}" },
      "overdue":     { "$value": "{primitive.color.red}" },
      "overdueRing": { "$value": "rgba(230, 57, 70, 0.14)" }
    },

    "chart": {
      "$type": "color",
      "$description": "Two colour systems, never mixed. Categories use the sequence in fixed order, maximum five series, no sixth exists. Conditions use the status scale. A chart uses one or the other.",
      "1":     { "$value": "{primitive.color.series1}" },
      "2":     { "$value": "{primitive.color.series2}" },
      "3":     { "$value": "{primitive.color.series3}" },
      "4":     { "$value": "{primitive.color.series4}" },
      "5":     { "$value": "{primitive.color.series5}" },
      "empty":     { "$value": "{primitive.color.grey}" },
      "emptyLine": { "$value": "{primitive.color.greyLine}" }
    },

    "type": {
      "display":  { "family": "{primitive.font.display}", "size": "52px", "weight": 700, "leading": 1.08, "tracking": "-0.005em", "$description": "Sentence case, 5–7 words." },
      "subhead":  { "family": "{primitive.font.display}", "size": "26px", "weight": 600, "leading": 1.15, "$description": "One line only." },
      "uiTitle":  { "family": "{primitive.font.ui}", "size": "16px", "weight": 600 },
      "body":     { "family": "{primitive.font.ui}", "size": "14px", "weight": 400, "leading": 1.5, "$description": "Base UI size is 13–14px." },
      "label":    { "family": "{primitive.font.ui}", "size": "13px", "weight": 500, "tracking": "0.02em" },
      "eyebrow":  { "family": "{primitive.font.ui}", "size": "12px", "weight": 600, "tracking": "0.1em", "case": "uppercase" },
      "caption":  { "family": "{primitive.font.ui}", "size": "12px", "weight": 400 },
      "numeric":  { "family": "{primitive.font.ui}", "weight": 600, "features": "tabular-nums", "$description": "Number columns use tabular figures so digits align down the column." }
    },

    "icon": {
      "$description": "Sharp corners only, no rounded joins or caps. Monoline. Built from straight lines and right angles. Never substituted for a library icon (Lucide, Feather, or any other) in product, website or marketing. The set is complete at thirteen module pictograms.",
      "stroke": { "$type": "dimension", "$value": "1.5px" },
      "sizeSm": { "$type": "dimension", "$value": "16px", "$description": "Collapsed icon rail, table rows." },
      "sizeMd": { "$type": "dimension", "$value": "20px", "$description": "Expanded sidebar." },
      "sizeLg": { "$type": "dimension", "$value": "24px", "$description": "Cards, standalone placements." },
      "fillException": "The midpoint square on Interface Management is the single permitted fill.",
      "modules": [
        "Dashboard", "Risk & Opportunities", "Change Management", "Nonconformance",
        "Documents", "Correspondence", "Site Inspection", "Permit & Compliance",
        "Time Log", "Project Economics", "Roles & Responsibility",
        "Interface Management", "HSE"
      ]
    },

    "logo": {
      "$description": "Every dimension is a ratio of icon height, x. Never rebuild the lockup by eye. Wordmark is Barlow Semi Condensed 700, descriptor is Inter 500. One flat colour, always.",
      "wordmarkRatio":     0.88,
      "wordmarkTracking":  "-0.034em",
      "gapRatio":          0.28,
      "descriptorRatio":   0.25,
      "descriptorFloor":   "10px",
      "realTimeRatio":     0.95,
      "realTimeTracking":  "-0.012em",
      "realTimeGap":       0.36,
      "clearSpaceRatio":   0.5,
      "clearSpaceOnPhoto": 1.0,
      "minSize": { "lockupA": "16px", "lockupB": "40px", "iconAlone": "16px" },
      "colorways": {
        "primary":    "{primitive.color.inkNavy}",
        "secondary":  "{primitive.color.indigo}",
        "reverse":    "{primitive.color.white}",
        "monochrome": "{primitive.color.black}"
      },
      "production": "SVG is the master. Wordmark text converted to outlines in every distributed file. PNG at 1x, 2x, 3x on transparent ground. No background rectangle except the app tile (14% inset on Ink Navy)."
    }
  }
}
